generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  firstName                String?
  lastName                 String?
  avatar                   String?
  phone                    String?
  latitude                 Float?
  longitude                Float?
  bio                      String?
  
  // Custom Authentication Fields
  passwordHash             String?                   // Hashed password for email/password auth
  emailVerified            Boolean                   @default(false)
  emailVerificationToken   String?                   @unique
  passwordResetToken       String?                   @unique
  passwordResetExpires     DateTime?
  refreshToken             String?                   @unique
  lastLogin                DateTime?
  isActive                 Boolean                   @default(true)
  
  // Legacy Supabase field (can be removed later)
  supabaseId               String?                   @unique
  preferences              Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  conversationParticipants ConversationParticipant[]
  deviceTokens             DeviceToken[]
  listings                 Listing[]
  receivedMatches          Match[]                   @relation("ReceivedMatches")
  sentMatches              Match[]                   @relation("SentMatches")
  messages                 Message[]
  notifications            Notification[]
  roommateProfile          RoommateProfile?

  @@index([email])
  @@index([latitude, longitude])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@index([refreshToken])
  @@index([createdAt])
  @@map("users")
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String?
  price         Float
  currency      String         @default("CAD")
  bedrooms      Int?
  bathrooms     Float?
  furnished     Boolean        @default(false)
  address       String?
  city          String?
  state         String?
  country       String         @default("CA")
  latitude      Float
  longitude     Float
  images        String[]
  isActive      Boolean        @default(true)
  isAvailable   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  cooling       String?
  heating       String?
  isFeatured    Boolean        @default(false)
  parkingSpots  Int?
  petPolicy     String?
  postalCode    String?
  province      String?
  smokingPolicy Boolean        @default(false)
  sqft          Int?
  utilities     String[]
  yearBuilt     Int?
  zipCode       String?
  propertyType  PropertyType
  listingImages ListingImage[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@index([latitude, longitude])
  @@index([userId, isActive])
  @@index([createdAt])
  @@index([price])
  @@index([city, province, country])
  @@index([isActive, isAvailable])
  @@index([country, province])
  @@map("listings")
}

model Match {
  id            String        @id @default(cuid())
  status        MatchStatus   @default(PENDING)
  message       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  listingId     String
  ownerId       String
  requesterId   String
  viewedByOwner Boolean       @default(false)
  conversation  Conversation?
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner         User          @relation("ReceivedMatches", fields: [ownerId], references: [id], onDelete: Cascade)
  requester     User          @relation("SentMatches", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, listingId])
  @@index([requesterId, status])
  @@index([ownerId, status])
  @@index([listingId])
  @@index([createdAt])
  @@index([status])
  @@map("matches")
}

model Conversation {
  id            String                    @id @default(cuid())
  matchId       String                    @unique
  isActive      Boolean                   @default(true)
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  match         Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([matchId])
  @@index([isActive])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  type           MessageType  @default(TEXT)
  mediaUrl       String?
  isRead         Boolean      @default(false)
  isEdited       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  senderId       String
  conversationId String
  isDeleted      Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  alt       String?
  order     Int      @default(0)
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([order])
  @@map("listing_images")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  isSent    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  emailSent Boolean          @default(false)
  imageUrl  String?
  pushSent  Boolean          @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id         String         @id @default(cuid())
  token      String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  userId     String
  appVersion String?
  isActive   Boolean        @default(true)
  lastUsed   DateTime       @default(now())
  platform   DevicePlatform
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([platform, isActive])
  @@index([token])
  @@map("device_tokens")
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
}

enum PropertyType {
  HOUSE
  CONDO
  APARTMENT
  TOWNHOUSE
  DUPLEX
  TRIPLEX
  BASEMENT_SUITE
  LOFT
  STUDIO
  ROOM
  COTTAGE
  MOBILE_HOME
  COMMERCIAL
  OTHER
}

enum NotificationType {
  MATCH_REQUEST
  MATCH_ACCEPTED
  MATCH_REJECTED
  NEW_MESSAGE
  LISTING_EXPIRED
  LISTING_FEATURED
  SYSTEM_UPDATE
  WELCOME
  REMINDER
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}
