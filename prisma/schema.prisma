// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum PropertyType {
  APARTMENT
  HOUSE
  CONDO
  ROOM
  STUDIO
  BASEMENT
  TOWNHOUSE
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  RENTED
}

enum Cleanliness {
  VERY_TIDY
  TIDY
  AVERAGE
  RELAXED
  VERY_RELAXED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
  EXPIRED
}

enum NotificationType {
  NEW_MESSAGE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  LISTING_VIEW
  PROFILE_VIEW
  PRICE_DROP
  NEW_MATCH
  VERIFICATION_COMPLETE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  role     UserRole @default(USER)

  // Profile
  firstName   String
  lastName    String
  phoneNumber String?
  dateOfBirth DateTime?
  bio         String?   @db.Text
  avatarUrl   String?

  // Verification
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationData   Json?

  // Preferences
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  refreshTokens        RefreshToken[]
  verificationAttempts VerificationAttempt[]
  propertyListings     PropertyListing[]
  roommateProfile      RoommateProfile?
  agentProfile         AgentProfile?
  favorites            Favorite[]
  sentConnections      Connection[]          @relation("SentConnections")
  receivedConnections  Connection[]          @relation("ReceivedConnections")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]
  notifications        Notification[]

  @@index([email])
  @@index([role])
  @@index([verificationStatus])
  @@map("users")
}

model AgentProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Agent Business Info
  agencyName      String
  licenseNumber   String  @unique
  yearsExperience Int
  website         String?
  officeAddress   String?

  // Specialization
  specializations String[] // residential, commercial, luxury, etc.
  serviceAreas    String[] // cities/neighborhoods they cover

  // Commission & Stats
  commissionRate  Decimal @default(0) @db.Decimal(5, 2)
  totalListings   Int     @default(0)
  activeListings  Int     @default(0)
  successfulDeals Int     @default(0)
  averageRating   Decimal @default(0) @db.Decimal(3, 2)

  // Verification
  isVerifiedAgent Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licenseNumber])
  @@index([isVerifiedAgent])
  @@map("agent_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model VerificationAttempt {
  id                String             @id @default(uuid())
  userId            String
  verificationToken String             @unique
  status            VerificationStatus @default(PENDING)
  documentUrl       String?
  faceImageUrl      String?
  failureReason     String?            @db.Text
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationToken])
  @@map("verification_attempts")
}

model PropertyListing {
  id      String @id @default(uuid())
  ownerId String

  // Basic Info
  title        String
  description  String         @db.Text
  propertyType PropertyType
  status       PropertyStatus @default(DRAFT)

  // Agent representation
  isRepresentedByAgent Boolean @default(false)
  representingAgentId  String?

  // Pricing
  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Location
  address   String
  city      String
  state     String
  zipCode   String
  country   String  @default("USA")
  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  // Property Details
  bedrooms   Int
  bathrooms  Decimal @db.Decimal(3, 1)
  squareFeet Int?
  furnished  Boolean @default(false)

  // Lease Terms
  availableFrom   DateTime?
  leaseDuration   Int? // months
  securityDeposit Decimal?  @db.Decimal(10, 2)

  // Amenities & Policies
  amenities      String[]
  utilities      String[]
  petPolicy      String?
  smokingAllowed Boolean  @default(false)

  // Media
  imageUrls String[]
  videoUrl  String?

  // Metadata
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  connections Connection[]

  @@index([ownerId])
  @@index([representingAgentId])
  @@index([status])
  @@index([city])
  @@index([propertyType])
  @@index([price])
  @@index([latitude, longitude])
  @@map("property_listings")
}

model RoommateProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Basic Info
  bio        String  @db.Text
  occupation String
  employer   String?
  ageRange   String?

  // Budget & Timing
  minBudget           Decimal  @db.Decimal(10, 2)
  maxBudget           Decimal  @db.Decimal(10, 2)
  preferredMoveInDate DateTime
  leaseTerm           Int // months

  // Lifestyle
  smoker        Boolean     @default(false)
  hasPets       Boolean     @default(false)
  petTypes      String[]
  cleanliness   Cleanliness @default(AVERAGE)
  sleepSchedule String? // early_bird, night_owl, flexible

  // Social
  guestsFrequency String? // never, rarely, sometimes, often
  workFromHome    Boolean @default(false)
  socialLevel     String? // introverted, ambivert, extroverted

  // Preferences
  preferredGender        String[] // male, female, non-binary, no-preference
  preferredPropertyTypes PropertyType[]
  preferredCities        String[]
  preferredNeighborhoods String[]
  preferredAmenities     String[]
  dealBreakers           String[]

  // Personal
  interests String[]
  languages String[]
  hobbies   String[]

  // Status
  isActive   Boolean @default(true)
  hasListing Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections Connection[]

  @@index([userId])
  @@index([isActive])
  @@index([hasListing])
  @@index([minBudget, maxBudget])
  @@map("roommate_profiles")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favorites")
}

model Connection {
  id                String  @id @default(uuid())
  requesterId       String
  recipientId       String
  listingId         String?
  roommateProfileId String?

  message       String?          @db.Text
  status        ConnectionStatus @default(PENDING)
  declineReason String?          @db.Text

  // Connection type
  connectionType String @default("listing") // listing, roommate, general

  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requester       User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient       User             @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)
  listing         PropertyListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  roommateProfile RoommateProfile? @relation(fields: [roommateProfileId], references: [id], onDelete: SetNull)
  conversation    Conversation?

  @@unique([requesterId, recipientId, listingId])
  @@unique([requesterId, recipientId, roommateProfileId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
  @@index([connectionType])
  @@map("connections")
}

model Conversation {
  id           String @id @default(uuid())
  connectionId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection Connection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  members    ConversationMember[]
  messages   Message[]

  @@index([connectionId])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  senderId       String

  content        String   @db.Text
  attachmentUrls String[]

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id      String              @id @default(uuid())
  userId  String
  type    NotificationType
  channel NotificationChannel

  title   String
  message String @db.Text
  data    Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}
